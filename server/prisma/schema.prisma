// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct (non-pooled) connection; on Neon this is the
  // connection string without "-pooler" in the host. Locally it's the same as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String                 @id @default(cuid())
  email              String                 @unique
  username           String                 @unique
  passwordHash       String
  // Bumped on password change or reset; logins issued before it stop working
  tokenVersion       Int                    @default(0)
  // Email me when someone replies to my question
  emailReplies       Boolean                @default(true)
  // Public profile: shown instead of the username where set
  displayName        String?
  bio                String?
  // Only the owner sees a private profile's Discuss activity
  isPrivate          Boolean                @default(false)
  // Pre-ticks "anonymous" when asking or replying in Discuss
  anonymousByDefault Boolean                @default(false)
  // When the photo last changed, so its URL changes and browsers fetch the new one; null means no photo
  avatarUpdatedAt    DateTime?
  createdAt          DateTime               @default(now())
  transactions       Transaction[]
  posts              Post[]
  replies            Reply[]
  budgets            Budget[]
  goals              Goal[]
  passwordResets     PasswordReset[]
  replyVotes         ReplyVote[]
  reports            Report[]
  notifications      Notification[]
  recurring          RecurringTransaction[]
  categories         Category[]
  avatar             Avatar?
}

// A profile photo, kept apart from User so the image bytes are only read when the photo is requested.
// Resized to a small square on the user's device before upload.
model Avatar {
  userId   String @id
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  data     Bytes
  mimeType String
}

model Transaction {
  id          String                @id @default(cuid())
  amount      Float
  type        String
  category    String
  note        String?
  date        DateTime              @default(now())
  userId      String
  user        User                  @relation(fields: [userId], references: [id])
  // Set when a recurring rule added this entry; cleared (not deleted) if the rule is stopped
  recurringId String?
  recurring   RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
}

// Anonymous posts and replies still store the real author for moderation;
// the API hides the author's identity from other users.
model Post {
  id            String         @id @default(cuid())
  title         String
  body          String
  topic         String
  isAnonymous   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  authorId      String
  author        User           @relation(fields: [authorId], references: [id])
  replies       Reply[]
  reports       Report[]
  notifications Notification[]

  @@index([createdAt])
}

model Reply {
  id            String         @id @default(cuid())
  body          String
  isAnonymous   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  postId        String
  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId      String
  author        User           @relation(fields: [authorId], references: [id])
  votes         ReplyVote[]
  reports       Report[]
  notifications Notification[]

  @@index([postId])
}

// A monthly spending limit for one expense category
model Budget {
  id        String   @id @default(cuid())
  category  String
  amount    Float
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, category])
}

model Goal {
  id           String    @id @default(cuid())
  name         String
  targetAmount Float
  savedAmount  Float     @default(0)
  targetDate   DateTime?
  createdAt    DateTime  @default(now())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
}

// A one-time password reset link. Only a SHA-256 hash of the token is stored,
// so a database leak can't be used to reset anyone's password.
model PasswordReset {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One "helpful" vote per user per reply
model ReplyVote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyId   String
  reply     Reply    @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([userId, replyId])
}

// A community report on a question (postId) or a reply (replyId); one per user per item
model Report {
  id         String   @id @default(cuid())
  reason     String
  createdAt  DateTime @default(now())
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  postId     String?
  post       Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  replyId    String?
  reply      Reply?   @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([reporterId, postId])
  @@unique([reporterId, replyId])
}

// Something the user should know about in Discuss. Repeats of the same unread event are
// grouped into one row by raising `count` (e.g. "3 new replies to your question").
model Notification {
  id        String    @id @default(cuid())
  // reply_to_question | reply_in_thread | helpful | post_hidden | reply_hidden
  kind      String
  count     Int       @default(1)
  // Question title at the time, so the notification still reads well if the title changes
  title     String
  readAt    DateTime?
  // When an email went out for this notification, used to send at most one per hour per question
  emailedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  replyId   String?
  reply     Reply?    @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// A monthly repeating transaction (salary, rent, SIP, EMI). Entries are added when due by a
// catch-up that runs as the user opens the app; nextDue marks the next entry not yet added.
model RecurringTransaction {
  id         String        @id @default(cuid())
  amount     Float
  type       String
  category   String
  note       String?
  // 1-31; in shorter months the entry lands on the month's last day
  dayOfMonth Int
  // The user's Date.getTimezoneOffset(), so "the 1st" means the 1st where they live
  tzOffset   Int
  nextDue    DateTime
  endDate    DateTime?
  paused     Boolean       @default(false)
  createdAt  DateTime      @default(now())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries    Transaction[]

  @@index([userId])
}

// The user's own list of categories, offered when adding transactions and managed in Settings.
// Transactions, budgets and recurring rules store the category by name; renaming or merging
// here updates those names too.
model Category {
  id        String   @id @default(cuid())
  name      String
  // income | expense
  type      String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, name])
}
