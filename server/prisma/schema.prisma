// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct (non-pooled) connection; on Neon this is the
  // connection string without "-pooler" in the host. Locally it's the same as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  username       String          @unique
  passwordHash   String
  // Bumped on password change or reset; logins issued before it stop working
  tokenVersion   Int             @default(0)
  createdAt      DateTime        @default(now())
  transactions   Transaction[]
  posts          Post[]
  replies        Reply[]
  budgets        Budget[]
  goals          Goal[]
  passwordResets PasswordReset[]
  replyVotes     ReplyVote[]
  reports        Report[]
}

model Transaction {
  id       String   @id @default(cuid())
  amount   Float
  type     String
  category String
  note     String?
  date     DateTime @default(now())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
}

// Anonymous posts and replies still store the real author for moderation;
// the API hides the author's identity from other users.
model Post {
  id          String   @id @default(cuid())
  title       String
  body        String
  topic       String
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  replies     Reply[]
  reports     Report[]

  @@index([createdAt])
}

model Reply {
  id          String      @id @default(cuid())
  body        String
  isAnonymous Boolean     @default(false)
  createdAt   DateTime    @default(now())
  postId      String
  post        Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId    String
  author      User        @relation(fields: [authorId], references: [id])
  votes       ReplyVote[]
  reports     Report[]

  @@index([postId])
}

// A monthly spending limit for one expense category
model Budget {
  id        String   @id @default(cuid())
  category  String
  amount    Float
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, category])
}

model Goal {
  id           String    @id @default(cuid())
  name         String
  targetAmount Float
  savedAmount  Float     @default(0)
  targetDate   DateTime?
  createdAt    DateTime  @default(now())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
}

// A one-time password reset link. Only a SHA-256 hash of the token is stored,
// so a database leak can't be used to reset anyone's password.
model PasswordReset {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One "helpful" vote per user per reply
model ReplyVote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyId   String
  reply     Reply    @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([userId, replyId])
}

// A community report on a question (postId) or a reply (replyId); one per user per item
model Report {
  id         String   @id @default(cuid())
  reason     String
  createdAt  DateTime @default(now())
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  postId     String?
  post       Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  replyId    String?
  reply      Reply?   @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([reporterId, postId])
  @@unique([reporterId, replyId])
}
