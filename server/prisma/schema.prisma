// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct (non-pooled) connection; on Neon this is the
  // connection string without "-pooler" in the host. Locally it's the same as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String                 @id @default(cuid())
  email              String                 @unique
  username           String                 @unique
  passwordHash       String
  // When the user confirmed they own the email; null until then
  emailVerifiedAt    DateTime?
  // Bumped on password change or reset; logins issued before it stop working
  tokenVersion       Int                    @default(0)
  // Email me when someone replies to my question
  emailReplies       Boolean                @default(true)
  // Tell me in the app when I reach 80% or 100% of a budget
  budgetAlerts       Boolean                @default(true)
  // Also email those budget alerts
  emailBudgetAlerts  Boolean                @default(false)
  // Public profile: shown instead of the username where set
  displayName        String?
  bio                String?
  // Only the owner sees a private profile's Discuss activity
  isPrivate          Boolean                @default(false)
  // Pre-ticks "anonymous" when asking or replying in Discuss
  anonymousByDefault Boolean                @default(false)
  // When the photo last changed, so its URL changes and browsers fetch the new one; null means no photo
  avatarUpdatedAt    DateTime?
  // The monthly recap (YYYY-MM) the user closed on Home, so its card stays hidden
  recapDismissed     String?
  createdAt          DateTime               @default(now())
  transactions       Transaction[]
  posts              Post[]
  replies            Reply[]
  budgets            Budget[]
  goals              Goal[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
  budgetAlertsSent   BudgetAlert[]
  replyVotes         ReplyVote[]
  reports            Report[]
  notifications      Notification[]         @relation("recipient")
  // Notifications about something this user did, e.g. "Asha started following you"
  actedIn            Notification[]         @relation("actor")
  following          Follow[]               @relation("follower")
  followers          Follow[]               @relation("followed")
  recurring          RecurringTransaction[]
  imports            Import[]
  goalContributions  GoalContribution[]
  categories         Category[]
  avatar             Avatar?
}

// A profile photo, kept apart from User so the image bytes are only read when the photo is requested.
// Resized to a small square on the user's device before upload.
model Avatar {
  userId   String @id
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  data     Bytes
  mimeType String
}

model Transaction {
  id          String                @id @default(cuid())
  amount      Float
  type        String
  category    String
  note        String?
  date        DateTime              @default(now())
  userId      String
  user        User                  @relation(fields: [userId], references: [id])
  // Set when a recurring rule added this entry; cleared (not deleted) if the rule is stopped
  recurringId String?
  recurring   RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  // Set when the entry came from a CSV import, so the whole import can be undone
  importId    String?
  import      Import?               @relation(fields: [importId], references: [id], onDelete: SetNull)

  @@index([importId])
}

// One CSV file the user imported
model Import {
  id           String        @id @default(cuid())
  fileName     String
  count        Int
  createdAt    DateTime      @default(now())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

// Anonymous posts and replies still store the real author for moderation;
// the API hides the author's identity from other users.
model Post {
  id              String         @id @default(cuid())
  title           String
  body            String
  topic           String
  isAnonymous     Boolean        @default(false)
  createdAt       DateTime       @default(now())
  authorId        String
  author          User           @relation(fields: [authorId], references: [id])
  replies         Reply[]        @relation("PostReplies")
  // The reply the asker marked as the answer; cleared if that reply is deleted
  acceptedReplyId String?        @unique
  acceptedReply   Reply?         @relation("AcceptedAnswer", fields: [acceptedReplyId], references: [id], onDelete: SetNull)
  reports         Report[]
  notifications   Notification[]

  @@index([createdAt])
}

model Reply {
  id            String         @id @default(cuid())
  body          String
  isAnonymous   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  postId        String
  post          Post           @relation("PostReplies", fields: [postId], references: [id], onDelete: Cascade)
  acceptedFor   Post?          @relation("AcceptedAnswer")
  authorId      String
  author        User           @relation(fields: [authorId], references: [id])
  votes         ReplyVote[]
  reports       Report[]
  notifications Notification[]

  @@index([postId])
}

// A monthly spending limit for one expense category
model Budget {
  id        String   @id @default(cuid())
  category  String
  amount    Float
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, category])
}

// A budget alert already given, so each level (80 or 100) fires at most once per category per month
model BudgetAlert {
  id        String   @id @default(cuid())
  category  String
  // The user's local month, e.g. "2026-10"
  month     String
  level     Int
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, month, level])
}

model Goal {
  id            String             @id @default(cuid())
  name          String
  targetAmount  Float
  savedAmount   Float              @default(0)
  targetDate    DateTime?
  createdAt     DateTime           @default(now())
  userId        String
  user          User               @relation(fields: [userId], references: [id])
  contributions GoalContribution[]
}

// Money added to (positive) or withdrawn from (negative) a goal, as actually applied. Goals that had
// money before this was recorded show the difference as saved before history started.
model GoalContribution {
  id        String   @id @default(cuid())
  amount    Float
  createdAt DateTime @default(now())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
  @@index([userId, createdAt])
}

// A one-time password reset link. Only a SHA-256 hash of the token is stored,
// so a database leak can't be used to reset anyone's password.
model PasswordReset {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A link sent to confirm the user owns their email; only the hash of the token is stored
model EmailVerification {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  // Set when the link confirms a change to this new address; null for confirming the signup email
  email     String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One "helpful" vote per user per reply
model ReplyVote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyId   String
  reply     Reply    @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([userId, replyId])
}

// A community report on a question (postId) or a reply (replyId); one per user per item
model Report {
  id         String   @id @default(cuid())
  reason     String
  createdAt  DateTime @default(now())
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  postId     String?
  post       Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  replyId    String?
  reply      Reply?   @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([reporterId, postId])
  @@unique([reporterId, replyId])
}

// Something the user should know about in Discuss. Repeats of the same unread event are
// grouped into one row by raising `count` (e.g. "3 new replies to your question").
model Notification {
  id        String    @id @default(cuid())
  // reply_to_question | reply_in_thread | helpful | post_hidden | reply_hidden
  // | follow_request | new_follower | follow_accepted | followed_post | budget_near | budget_over | recap_ready
  // | answer_accepted
  kind      String
  count     Int       @default(1)
  // Question title at the time, so the notification still reads well if the title changes;
  // for budget alerts, the whole message; for recap_ready, the month (YYYY-MM)
  title     String
  readAt    DateTime?
  // When an email went out for this notification, used to send at most one per hour per question
  emailedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String
  user      User      @relation("recipient", fields: [userId], references: [id], onDelete: Cascade)
  // Empty for follow notifications, which aren't about a question
  postId    String?
  post      Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  replyId   String?
  reply     Reply?    @relation(fields: [replyId], references: [id], onDelete: Cascade)
  // Who it's about, for follow notifications and new questions from people you follow; never
  // set for anything that could reveal who wrote an anonymous post
  actorId   String?
  actor     User?     @relation("actor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// One person following another. Following a private profile starts as a request ("pending")
// that the profile's owner accepts; public profiles are followed straight away ("accepted").
model Follow {
  id          String   @id @default(cuid())
  status      String
  createdAt   DateTime @default(now())
  followerId  String
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("followed", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, status])
}

// A monthly repeating transaction (salary, rent, SIP, EMI). Entries are added when due by a
// catch-up that runs as the user opens the app; nextDue marks the next entry not yet added.
model RecurringTransaction {
  id         String        @id @default(cuid())
  amount     Float
  type       String
  category   String
  note       String?
  // 1-31; in shorter months the entry lands on the month's last day
  dayOfMonth Int
  // The user's Date.getTimezoneOffset(), so "the 1st" means the 1st where they live
  tzOffset   Int
  nextDue    DateTime
  endDate    DateTime?
  paused     Boolean       @default(false)
  createdAt  DateTime      @default(now())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries    Transaction[]

  @@index([userId])
}

// The user's own list of categories, offered when adding transactions and managed in Settings.
// Transactions, budgets and recurring rules store the category by name; renaming or merging
// here updates those names too.
model Category {
  id        String   @id @default(cuid())
  name      String
  // income | expense
  type      String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, name])
}
